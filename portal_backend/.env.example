# --- App ---
APP_NAME=Portal do Condômino API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Banco de dados ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_condomino
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://portal:portal@localhost:5433/portal_condomino

# --- Auth (JWT) ---
JWT_SECRET_KEY=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_API_KEY=

# --- Sienge ---
SIENGE_USE_MOCK=true
SIENGE_BASE_URL=https://api.sienge.com.br/SUBDOMINIO/public/api/v1
SIENGE_USER=
SIENGE_PASSWORD=
SIENGE_WEBHOOK_SECRET=
SIENGE_TIMEOUT_SECONDS=30
SIENGE_MAX_RETRIES=3
SIENGE_BACKOFF_SECONDS=5
SIENGE_MAX_WAIT_SECONDS=60
SIENGE_PAGE_LIMIT=200
SYNC_LOOKBACK_DAYS=7
SYNC_FOTOS_POR_EXECUCAO=200

# --- Sincronização & Agendador ---
SYNC_CRON_HOURS=6,18
SYNC_TIMEZONE=America/Sao_Paulo
SCHEDULER_ENABLED=true

# --- Pipeline de Mídia (Pillow WebP) ---
MEDIA_MAX_LADO_PX=1920
MEDIA_QUALIDADE_WEBP=80

# --- Object Storage (Cloudflare R2 / Supabase, compatível S3) ---
# Se STORAGE_ENDPOINT_URL estiver em branco, usa STORAGE_LOCAL_DIR em disco local
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=portal-fotos
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=media
